<%- include("partials/head") %>
<%- include("partials/header") %>
<%
  const catTitle = (page && page.title) || cat.label;
  const cta = trip.ctaLabel || cat.enquire;
  const paragraphs = [trip.shortDescription, ...String(trip.overview || "").split(/\n\s*\n/)].map((s) => s.trim()).filter(Boolean);
  // Trips entered before the facts list existed still have their separate fields.
  // A two or three sentence answer for search and AI tools, made only from this trip's own facts.
  const fact = (name) => ((trip.facts || []).find((f) => f.label === name) || {}).value;
  const summary = [
    [trip.title + " is", [fact("Duration") || trip.duration, fact("Format")].filter(Boolean).join(", "), "with XPITUDE in Pakistan"].filter(Boolean).join(" ").replace(/ is with/, " is a trip with") + ".",
    [fact("Grade") && "Grade: " + fact("Grade") + ".", (fact("Best Season") || trip.season) && "Best season: " + (fact("Best Season") || trip.season) + ".", fact("Max Altitude") && "Highest point: " + fact("Max Altitude") + "."].filter(Boolean).join(" "),
    trip.tagline ? trip.tagline + "." : "",
  ].filter(Boolean).join(" ").replace(/\.\./g, ".");
  // Travel Guide pages that help plan this kind of trip
  const guideLinks = { trekking: ["trekking-trip-difficulty-grades", "packing-equipment-checklist", "travel-insurance-guide"],
    tours: ["best-time-to-visit-pakistan", "recommended-flights-airlines", "pakistan-visa-guide"],
    spiritual: ["pakistan-at-a-glance", "best-time-to-visit-pakistan", "pakistan-visa-guide"],
    corporate: ["is-pakistan-safe-to-travel", "travel-insurance-guide", "pakistan-at-a-glance"] }[trip.category] || [];
  const facts = trip.facts.length ? trip.facts
    : [["Duration", trip.duration], ["Season", trip.season], ["Altitude", trip.altitude], ["Travel", trip.mode], ["Grade", trip.grade], ["Region", trip.region]]
        .filter((f) => f[1]).map(([label, value]) => ({ label, value }));
  // Two photos from this trip's own folder, the first two in the order saved in admin ("Trip page photos"), both at the
  // width of the text: one after the opening text and one after the full itinerary.
  const pics = (trip.photos || []).filter((p) => p.src && p.src !== trip.image);
  const caption = (alt) => { const c = String(alt).includes(": ") ? alt.slice(alt.indexOf(": ") + 2) : alt; return c.charAt(0).toUpperCase() + c.slice(1) + "."; };
  const firstPic = pics[0] || null, secondPic = pics[1] || null;
  // a photo that opens the lightbox, with srcset copies (lib/blog-layout.js)
  const zoomPic = (p, sizes) => `<a class="xs-zoom" href="${photoEsc(p.src)}" data-lb data-alt="${photoEsc(caption(p.alt))}">${photoImg(p.src, p.alt, { sizes, pos: "center 45%" })}</a>`;
  const leadText = paragraphs[0], moreText = paragraphs.slice(1);
  const icons = { Duration: "schedule", Grade: "landscape", "Max Altitude": "terrain", "Best Season": "calendar_month", Stay: "hotel", Departure: "flight_takeoff",
    Destinations: "location_on", Format: "event", "Group Size": "groups" };
  const iconFor = (label) => icons[label] || "star";
  const short = (v) => String(v || "").split(/[,.](?:\s|$)/)[0].trim();
  const sideFacts = (trip.category === "corporate"
      ? [["Format", fact("Format")], ["Group size", fact("Group Size")]]
      : [["Duration", fact("Duration"), trip.durationLabel], [trip.category === "spiritual" ? "Level" : "Grade", fact("Grade"), trip.grade], ["Best season", fact("Best Season"), trip.season]])
    .filter((r) => r[1]).map(([k, full, s]) => [k, s || short(full), full]);
  const waLink = site.whatsappUrl ? site.whatsappUrl.split("?")[0] + "?text=" + encodeURIComponent("Hi XPITUDE, I'd like to plan the " + trip.title + ".") : "";
%>
<main>
<%- include("partials/blog-banner", {
  photo: trip.image, photoHtml: trip.image ? photoImg(trip.image, trip.imageAlt || trip.title, { sizes: "(max-width: 767px) 100vw, 50vw", eager: true }) : "",
  fit: bannerFit(trip.image), name: "trip-" + trip.slug,
  label: catTitle, title: trip.title, bannerIntro: trip.tagline,
}) %>

<section class="section xdetail">
  <div class="wrap xpwrap">
    <article class="xp">
<% if (paragraphs.length) { %>      <div class="note xp__sum"><b>In short.</b> <%= summary %></div>
      <div class="xp__lead xs-part"><p class="xs-lead"><%= leadText %></p></div>
<% } if (firstPic) { %>      <figure class="xs-fig xs-fig--text"><%- zoomPic(firstPic, "(max-width: 760px) 100vw, 720px") %><figcaption><%= caption(firstPic.alt) %></figcaption></figure>
<% } if (moreText.length) { %>      <div class="xp__lead xs-part">
<% moreText.forEach((text) => { %>        <p><%= text %></p>
<% }) %>      </div>
<% } %>
<% if (facts.length) { %>      <section class="xp__sec">
        <h2><%= trip.factsTitle || "At a Glance" %></h2>
        <dl class="xfacts">
<% facts.forEach((f) => { %>          <div><span class="material-symbols-outlined" aria-hidden="true"><%= iconFor(f.label) %></span><dt><%= f.label %></dt><dd><%= f.value %></dd></div>
<% }) %>        </dl>
<% if (trip.grade && trip.category === "trekking") { %>        <p class="xp__note"><a href="/travel-guide/trekking-trip-difficulty-grades">What the grades mean</a></p>
<% } %>      </section>
<% } %>
<% if (trip.highlights.length) { %>      <section class="xp__sec">
        <div>
          <h2><%= trip.highlightsTitle || "Highlights" %></h2>
          <ul class="xlist xlist--yes xlist--cols">
<% trip.highlights.forEach((x) => { %>            <li><%= x %></li>
<% }) %>          </ul>
        </div>
      </section>
<% } %>
      <section class="xp__sec">
        <h2><%= trip.itineraryTitle || "Itinerary" %></h2>
<% if (trip.fullItinerary.length) { %>        <ol class="xtl">
<% trip.fullItinerary.forEach((d, i) => { const label = d.label || "Day " + (d.day || i + 1); const n = (label.match(/Day (\d+)$/) || [])[1] || i + 1; %>          <li><span class="xtl__n" aria-hidden="true"><%= n %></span><div class="xtl__txt"><h3><%= label %><% if (d.title) { %>: <%= d.title %><% } %></h3><% if (d.description) { %><p><%= d.description %></p><% } %></div></li>
<% }) %>        </ol>
<% } else { %>        <p>Every departure is planned around your group and your dates. Send an enquiry and a planner will come back within one working day with the full day by day itinerary.</p>
<% } %>      </section>
<% if (secondPic) { %>      <figure class="xs-fig xs-fig--text"><%- zoomPic(secondPic, "(max-width: 760px) 100vw, 720px") %><figcaption><%= caption(secondPic.alt) %></figcaption></figure>
<% } %>

<% if (trip.includes.length || trip.excludes.length) { %>      <section class="xp__sec xinc">
<% if (trip.includes.length) { %>        <div>
          <h2>What's Included</h2>
          <ul class="xlist xlist--yes">
<% trip.includes.forEach((x) => { %>            <li><%= x %></li>
<% }) %>          </ul>
        </div>
<% } if (trip.excludes.length) { %>        <div>
          <h2>What's Not Included</h2>
          <ul class="xlist xlist--no">
<% trip.excludes.forEach((x) => { %>            <li><%= x %></li>
<% }) %>          </ul>
        </div>
<% } %>      </section>
<% } %>
<% if (trip.services.length) { %>      <section class="xp__sec">
        <div>
          <h2>Services</h2>
          <ul class="xlist xlist--yes xlist--cols">
<% trip.services.forEach((x) => { %>            <li><%= x %></li>
<% }) %>          </ul>
        </div>
      </section>
<% } %>
<% if (trip.info.length) { %>      <section class="xp__sec">
        <div class="xinfobox">
          <h2><%= trip.infoTitle || "Good to Know" %></h2>
          <ul class="xlist xlist--dot">
<% trip.info.forEach((x) => { %>            <li><%= x %></li>
<% }) %>          </ul>
        </div>
      </section>
<% } %>
<% const guidesToRead = guideLinks.map((s) => nav.guides.find((g) => g.slug === s)).filter(Boolean); if (guidesToRead.length) { %>      <section class="xp__sec">
        <h2>Before you go</h2>
        <ul class="xlist xlist--dot">
<% guidesToRead.forEach((g) => { %>          <li><a href="<%= g.url %>"><%= g.title %></a></li>
<% }) %>        </ul>
      </section>
<% } %>      <section class="xp__end">
<% if (trip.says) { %>        <blockquote class="xsays"><span class="data">XPITUDE Says</span><p><%= trip.says %></p></blockquote>
<% } %>        <div class="xp__cta">
          <div class="xp__btns">
            <a href="/contact" class="btn btn--primary"><%= cta %> <span class="arw"></span></a>
<% if (waLink) { %>            <a href="<%= waLink %>" class="btn xbtn-wa" target="_blank" rel="noopener noreferrer" aria-label="Ask about <%= trip.title %> on WhatsApp"><%- icon("whatsapp") %> WhatsApp</a>
<% } %>          </div>
<% if (trip.ctaNote) { %>          <p><%= trip.ctaNote %></p>
<% } %>        </div>
      </section>
    </article>

    <aside class="xside" aria-label="Plan this trip">
      <div class="xside__card">
        <span class="data">Plan this trip</span>
        <p class="xside__t"><%= trip.cardTitle || trip.title %></p>
        <dl class="xside__facts">
<% sideFacts.forEach(([k, v, full]) => { %>          <div><dt><%= k %></dt><dd title="<%= full %>"><%= v %></dd></div>
<% }) %>        </dl>
        <a href="/contact" class="btn btn--primary" title="<%= cta %>">Enquire <span class="arw"></span></a>
<% if (waLink) { %>        <a href="<%= waLink %>" class="btn xbtn-wa" target="_blank" rel="noopener noreferrer" aria-label="Ask about <%= trip.title %> on WhatsApp"><%- icon("whatsapp") %> WhatsApp</a>
<% } %>      </div>
    </aside>
  </div>
</section>
<% if (firstPic) { %><div class="lbox" id="lbox" role="dialog" aria-modal="true" aria-label="Photo viewer" hidden>
  <button class="lbox__close" type="button" aria-label="Close">×</button>
  <button class="lbox__nav lbox__nav--prev" type="button" aria-label="Previous photo">‹</button>
  <figure class="lbox__fig"><img alt=""><figcaption></figcaption></figure>
  <button class="lbox__nav lbox__nav--next" type="button" aria-label="Next photo">›</button>
</div>
<% } %>
</main>
<%- include("partials/footer") %>
