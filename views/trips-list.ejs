<%- include("partials/head") %>
<%- include("partials/header") %>
<%
  // The page copy comes from the Service pages section of the admin; the site settings are the fallback.
  const pageTitle = (page && page.title) || cat.label;
  const heroImage = (page && page.image) || "/assets/" + cat.image;
  const heroAlt = (page && page.imageAlt) || cat.imageAlt;
%>
<main>
<%- include("partials/blog-banner", {
  photo: heroImage, photoHtml: photoImg(heroImage, heroAlt, { sizes: "(max-width: 767px) 100vw, 50vw", eager: true }),
  fit: bannerFit(heroImage), name: "services-" + cat.key,
  label: "Our Services", title: pageTitle, bannerIntro: [page && page.tagline, (page && page.intro) || cat.sub],
}) %>

<section class="section">
  <div class="wrap">
<% if (trips.length) { %>    <div class="grid-3 xgrid">
<% trips.forEach((trip) => { %><%- include("partials/exp-card", { trip }) %><% }) %>
    </div>
<% } else { %>    <div class="chead"><p class="chead__sub">New departures are being planned. Tell us what you have in mind and we will build it around your group.</p></div>
    <div class="center-cta"><a href="/contact" class="tlink"><%= cat.enquire %> <span class="arw"></span></a></div>
<% } %>  </div>
</section>

<% if (info.length) { %>
<section class="section xinfo">
  <div class="wrap">
<% if (page && page.infoTitle) { %>    <div class="chead chead--tight"><h2 class="d2"><%= page.infoTitle %></h2></div>
<% } %>    <div class="xinfo__grid">
<% info.forEach((item) => { %>      <div class="xinfo__i"><h3><%= item.title %></h3><p><%= item.body %></p></div>
<% }) %>    </div>
  </div>
</section>
<% } %>

<% if (page && page.closingTitle) { %>
<section class="section on-red cta cta--services">
  <div class="wrap">
    <h2 class="d2"><%= page.closingTitle %></h2>
<% if (page.closingText) { %>    <p class="xclose"><%= page.closingText %></p>
<% } %>    <a href="/contact" class="btn btn--sd"><%= page.closingButton || "Plan your journey" %> <span class="arw"></span></a>
  </div>
</section>
<% } else { %><%- include("partials/cta") %><% } %>
</main>
<%- include("partials/footer") %>
