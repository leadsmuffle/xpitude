<%- include("partials/head") %>
<%- include("partials/header") %>
<main>
<%- include("partials/blog-banner", {
  photo: guide.image, photoHtml: guide.image ? blogHelpers.img(guide.image, guide.imageAlt || guide.title, { sizes: "(max-width: 767px) 100vw, 50vw", eager: true }) : "",
  fit: blogHelpers.bannerFit(guide.image), name: "guide-" + guide.slug,
  label: "Travel Guide · " + String(index + 1).padStart(2, "0") + " of " + guides.length, title: guide.title, bannerIntro: guide.summary,
}) %>

<section class="section gpage">
  <div class="wrap">
    <div class="guide">
      <article class="prose gprose">
<% const answer = [guide.summary, guide.metaDescription].filter(Boolean).filter((s, i, a) => a.indexOf(s) === i).join(" "); if (answer) { %>        <div class="note"><b>In short.</b> <%= answer %></div>
<% } %><%- guideHtml %>
        <p class="prose__foot">General guidance for planning. Rules, schedules and conditions change, so confirm the details that matter with official sources and with your XPITUDE planner before you book.</p>
      </article>
      <aside class="gside" aria-label="Travel Guide pages">
        <h2>Travel Guide</h2>
        <ol>
<% guides.forEach((g) => { %>          <li><a<%- g.slug === guide.slug ? ' class="is-active" aria-current="page"' : "" %> href="<%= g.url %>"><span><%= String(g.number).padStart(2, "0") %></span><%= g.title %></a></li>
<% }) %>        </ol>
      </aside>
    </div>

    <nav class="gpager" aria-label="More from the Travel Guide">
<% [["prev", prev, "Previous guide"], ["next", next, "Next guide"]].forEach(([cls, g, label]) => { if (!g) return; %>      <a class="gpager__i gpager__i--<%= cls %>" href="<%= g.url %>">
<% if (g.image) { %>        <span class="gpager__img"><img src="<%= g.image %>" alt="<%= g.imageAlt || g.title %>" loading="lazy" decoding="async"></span>
<% } %>        <span class="gpager__txt"><span class="data"><%= label %></span><b><%= g.title %></b></span>
      </a>
<% }) %>    </nav>

    <div class="gcta">
      <h2 class="d2">Tell us the month. We'll tell you what's possible.</h2>
      <a href="/contact" class="btn btn--sd">Plan your journey <span class="arw"></span></a>
    </div>
  </div>
</section>
<div class="lbox" id="lbox" role="dialog" aria-modal="true" aria-label="Photo viewer" hidden>
  <button class="lbox__close" type="button" aria-label="Close">×</button>
  <button class="lbox__nav lbox__nav--prev" type="button" aria-label="Previous photo">‹</button>
  <figure class="lbox__fig"><img alt=""><figcaption></figcaption></figure>
  <button class="lbox__nav lbox__nav--next" type="button" aria-label="Next photo">›</button>
</div>
</main>
<%- include("partials/footer") %>
