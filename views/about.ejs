<%- include("partials/head") %>
<%- include("partials/header") %>
<main>
<%- include("partials/phero", {
  image: "/assets/camp.jpg", imageAlt: "Expedition camp under the stars at Goro II, Masherbrum behind", crumbs: [["Home", "/"], ["About Us"]],
  eyebrow: "About Us", h1: "Experience Altitude",
  sub: "Trekking expeditions, guided tours and spiritual journeys across Pakistan, planned and led end to end.",
}) %>

<section class="section">
  <div class="wrap">
    <div class="chead">
      <p class="eyebrow">Who we are</p>
      <h2 class="d2">A licensed tour operator in Gilgit-Baltistan.</h2>
      <p class="chead__sub">Every experience is privately run, fully supported and built around your group.</p>
    </div>
    <div class="cats">
<% ["trekking", "tours", "spiritual"].forEach((key, i) => { const c = categories[key]; %>      <a href="<%= c.path %>" class="cat">
        <img src="/assets/<%= c.image %>" alt="<%= c.imageAlt %>" loading="lazy" decoding="async">
        <div class="cat__c"><span class="cat__n">0<%= i + 1 %></span><h3 class="d3"><%= c.menuLabel || c.label %></h3>
          <p><%= c.blurb %></p></div>
      </a>
<% }) %>    </div>
  </div>
</section>

<section class="section founder" aria-labelledby="founderTitle">
  <div class="wrap founder__in">
    <img class="founder__img" src="/assets/founder-daniyal.jpg" alt="Muhammad Daniyal Naeem, Founder of XPITUDE, in the Karakoram" width="576" height="480" loading="lazy" decoding="async">
    <div class="founder__txt">
      <p class="founder__label">Founder&#39;s Note</p>
      <h2 class="founder__h" id="founderTitle">The mind behind the brand</h2>
      <div class="founder__card">
        <p class="founder__p">XPITUDE started with a simple belief: the mountains of Pakistan deserve to be experienced properly, with care, honesty and the right people beside you. We keep our groups small, work with local guides and never cut corners on safety. If you travel with us, you are not a booking. You are part of the team.</p>
        <p class="founder__sign">Muhammad Daniyal Naeem</p>
        <p class="founder__role">Founder, XPITUDE</p>
      </div>
    </div>
  </div>
</section>

<%- include("partials/promise") %>

<section class="section on-dark">
  <div class="wrap corp">
    <div class="corp__media"><img src="/assets/arc-4.jpg" alt="A porter and pack horse on the Baltoro trail" loading="lazy" decoding="async"></div>
    <div>
      <p class="eyebrow">Based in Lahore</p>
      <h2 class="d2">Tell us the month. We'll tell you what's possible.</h2>
      <p class="lede" style="margin-top:calc(12 * var(--px))">Send a rough idea and a rough date. A planner comes back within one working day with two or three routes that fit your group, and an honest word about the one that does not.</p>
<%- include("partials/contact-details") %>
      <p style="margin-top:var(--block-gap)"><a href="/contact" class="btn btn--sd">Plan your journey <span class="arw"></span></a></p>
    </div>
  </div>
</section>
</main>
<%- include("partials/footer") %>
