<%
  /* Options: trip (required), reveal (default true) */
  const rv = locals.reveal === false ? "" : " rv";
%>
      <a href="<%= trip.url %>" class="card<%= rv %>">
        <div class="card__media"><% if (trip.season) { %><span class="card__badge"><%= trip.season %></span><% } %><% if (trip.image) { %><img src="<%= trip.image %>" alt="<%= trip.imageAlt || trip.title %>" loading="lazy" decoding="async"<% if (trip.imagePosition) { %> style="object-position:<%= trip.imagePosition %>"<% } %>><% } else { %>
          <div class="ph"><svg viewBox="0 0 99 99" aria-hidden="true"><polygon points="0,16.5 17.5,0 99,81.5 81.5,99"/><polygon points="0,82.5 17.5,99 58,58 41,41"/><polygon points="82.8,0 99,16.3 82.8,32.6 66.6,16.3"/></svg>
            <span>Photograph needed<% if (trip.imageNote) { %><br><%= trip.imageNote %><% } %></span></div><% } %></div>
        <div class="card__body"><h3 class="d3"><%= trip.title %></h3><% if (trip.spec) { %><span class="data card__spec"><%= trip.spec %></span><% } %>
          <p><%= trip.shortDescription %></p>
          <div class="card__foot"><div><span class="data"><%= trip.price ? "From, per person" : "Price" %></span><b class="price"><%= trip.price || "On request" %></b></div><span class="data"><%= trip.duration %></span></div></div>
      </a>
