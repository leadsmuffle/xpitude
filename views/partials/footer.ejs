<!-- ====== FOOTER ====== -->
<footer class="footer">
  <div class="wrap">
    <div class="footer__top">
      <div class="fcol1">
        <div class="frow1">
        <div class="brand">
          <img class="brand__logo" src="/assets/xpitude-logo.png" alt="XPITUDE, experience altitude" width="406" height="324" loading="lazy">
        </div>
        <p class="footer__blurb">Trekking expeditions, guided tours and spiritual journeys across Pakistan, planned and led end to end.</p>
        </div>
        <div class="frow2">
<% if (Object.values(site.follow || {}).some(Boolean)) { %>        <div class="ffollow"><%- include("follow") %></div>
<% } %>        </div>
      </div>
      <div class="fcol"><div class="frow1"><h4>Services</h4><ul>
<% [["trekking", "Trekking Expeditions"], ["tours", "Tours and Sightseeing"], ["spiritual", "Spiritual Trips and Yoga Retreats"], ["corporate", "Corporate Retreats"]].forEach(([key, label]) => { const list = nav[key] || []; %>        <li><a href="/<%= key %>"><%= label %></a><% if (list.length) { %><button class="fsv__btn" type="button" aria-expanded="false" aria-controls="fsv-<%= key %>" aria-label="Show the <%= label %> trips"><span class="material-symbols-outlined" aria-hidden="true">expand_more</span></button>
          <ul class="fsv__list" id="fsv-<%= key %>" inert>
<% list.forEach((t) => { %>            <li><a href="<%= t.url %>"><%= t.title %></a></li>
<% }) %>          </ul><% } %></li>
<% }) %>      </ul></div>
        <div class="fcon"><span class="material-symbols-outlined" aria-hidden="true">location_on</span><span><%= site.address.street.split(",")[0] %>, <%= site.address.city %></span></div></div>
      <div class="fcol"><div class="frow1"><h4>Company</h4><ul>
        <li><a href="/about">About Us</a></li><li><a href="/blog">Our Blog</a></li>
        <li><a href="/testimonials">Client Testimonials</a></li><li><a href="/contact">Contact Us</a></li></ul></div>
<% if (site.email) { %>        <div class="fcon"><span class="material-symbols-outlined" aria-hidden="true">mail</span><a href="mailto:<%= site.email %>"><%= site.email %></a></div>
<% } %>      </div>
      <div class="fcol"><div class="frow1"><h4>Travel Guide</h4><ul>
<% const tg = nav.guideMenu || []; tg.slice(0, 4).forEach(({ g, label }) => { %>        <li><a href="<%= g.url %>" title="<%= g.title %>"><%= label %></a></li>
<% }); if (tg.length > 4) { %>        <li><button class="fmore" type="button" aria-expanded="false" aria-controls="fmoreList"><span class="fmore__t">More</span><span class="material-symbols-outlined" aria-hidden="true">expand_more</span></button>
          <ul class="fmore__list" id="fmoreList" inert>
<% tg.slice(4).forEach(({ g, label }) => { %>            <li><a href="<%= g.url %>" title="<%= g.title %>"><%= label %></a></li>
<% }) %>          </ul></li>
<% } %>      </ul></div>
<% if (site.phone) { %>        <div class="fcon"><span class="material-symbols-outlined" aria-hidden="true">call</span><a href="<%= site.whatsappChat || site.phoneHref %>"<% if (site.whatsappChat) { %> target="_blank" rel="noopener noreferrer" aria-label="Chat with XPITUDE on WhatsApp, <%= site.phone %>"<% } %>><%= site.phone %></a></div>
<% } %>      </div>
    </div>
    <div class="footer__bottom">
      <span class="data">© <%= year %> XPITUDE · Licensed tour operator, Gilgit-Baltistan</span>
      <span class="data fbl"><a href="/privacy-policy">Privacy Policy</a><span class="fbl__sep" aria-hidden="true"> · </span><a href="/terms-of-service">Terms of Service</a><span class="fbl__sep" aria-hidden="true"> · </span><button class="fbl__ck" type="button" data-cookie-settings>Cookie Settings</button></span>
    </div>
  </div>
</footer>
<%- include("cookie-consent") %>

<% if (site.whatsappChat) { %><a class="wafloat" id="waFloat" href="<%= site.whatsappChat %>" aria-label="Chat with XPITUDE on WhatsApp" target="_blank" rel="noopener noreferrer"><%- icon("whatsapp") %><span class="wafloat__tip" aria-hidden="true">Chat with us</span></a>
<% } %><script src="/assets/site.js?v=<%= v %>"></script>
</body>
</html>
