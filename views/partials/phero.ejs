<%
  /* Options: h1 (required), eyebrow, sub, image, imageAlt, crumbs: [[label, href?], ...] */
%>
<section class="phero">
<% if (locals.image) { %>  <div class="phero__media"><img src="<%= image %>" alt="<%= locals.imageAlt || "" %>" fetchpriority="high"></div>
  <div class="phero__scrim"></div>
<% } %>  <div class="wrap">
<% if (locals.crumbs) { %>    <nav class="crumbs" aria-label="Breadcrumb"><% crumbs.forEach((c, i) => { %><% if (i) { %><span>/</span><% } %><% if (c[1]) { %><a href="<%= c[1] %>"><%= c[0] %></a><% } else { %><span><%= c[0] %></span><% } %><% }) %></nav>
<% } if (locals.eyebrow) { %>    <p class="eyebrow"><%= eyebrow %></p>
<% } %>    <h1><%= h1 %></h1>
<% if (locals.sub) { %>    <p class="phero__sub"><%= sub %></p>
<% } %>  </div>
</section>
