<!-- ====== COOKIE CONSENT (site.js shows it on the first visit; "Cookie Settings" in the footer opens the panel) ====== -->
<div class="ck" id="ckBanner" role="region" aria-label="Cookie notice" hidden>
  <p class="ck__txt">We use a necessary cookie to run this site. With your permission we would also use analytics and marketing cookies. <a href="/privacy-policy">Privacy Policy</a></p>
  <div class="ck__btns">
    <button class="ck__btn ck__btn--main" type="button" data-ck="all">Accept all</button>
    <button class="ck__btn" type="button" data-ck="none">Reject non-essential</button>
    <button class="ck__btn ck__btn--link" type="button" data-ck="open">Settings</button>
  </div>
</div>
<div class="ckp" id="ckPanel" role="dialog" aria-modal="true" aria-labelledby="ckTitle" hidden>
  <div class="ckp__box">
    <h2 class="ckp__h" id="ckTitle">Cookie Settings</h2>
    <p class="ckp__p">Choose which cookies we may use. You can change this at any time.</p>
    <div class="ckp__row">
      <div><b>Necessary</b><span>Keeps the site working and remembers this choice. Always on.</span></div>
      <label class="ckp__sw"><input type="checkbox" checked disabled aria-label="Necessary cookies, always on"><i></i></label>
    </div>
    <div class="ckp__row">
      <div><b>Analytics</b><span>Helps us see which pages are useful, without identifying you.</span></div>
      <label class="ckp__sw"><input type="checkbox" id="ckAnalytics" aria-label="Analytics cookies"><i></i></label>
    </div>
    <div class="ckp__row">
      <div><b>Marketing</b><span>Lets us measure our adverts and show relevant ones.</span></div>
      <label class="ckp__sw"><input type="checkbox" id="ckMarketing" aria-label="Marketing cookies"><i></i></label>
    </div>
    <div class="ckp__btns">
      <button class="ck__btn" type="button" data-ck="none">Reject non-essential</button>
      <button class="ck__btn" type="button" data-ck="all">Accept all</button>
      <button class="ck__btn ck__btn--main" type="button" data-ck="save">Save choices</button>
    </div>
  </div>
</div>
