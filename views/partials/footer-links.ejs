<%#
  One footer link list: the links in `items` ({ href, label, title, cls }), then a "More" button that opens `rest`, then `after`.
  Called by footer.ejs for each column; site.js handles every More button.
%><ul class="flist">
<% items.forEach((i) => { %>  <li><a<% if (i.cls) { %> class="<%= i.cls %>"<% } %> href="<%= i.href %>" title="<%= i.title || i.label %>"><%= i.label %></a></li>
<% }); if (rest.length) { %>  <li><button class="fmore" type="button" aria-expanded="false" aria-controls="<%= id %>"><span class="fmore__t">More</span><span class="material-symbols-outlined" aria-hidden="true">expand_more</span></button>
    <ul class="fmore__list" id="<%= id %>" inert>
<% rest.forEach((i) => { %>      <li><a<% if (i.cls) { %> class="<%= i.cls %>"<% } %> href="<%= i.href %>" title="<%= i.title || i.label %>"><%= i.label %></a></li>
<% }) %>    </ul></li>
<% } if (locals.after) { %>  <li><a class="flist__all" href="<%= after.href %>"><%= after.label %></a></li>
<% } %></ul>
