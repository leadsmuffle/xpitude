<%- include("partials/head") %>
<%- include("partials/header") %>

<aside class="altimeter" id="altimeter" aria-hidden="true">
  <div class="altimeter__read" id="altRead">0 M</div>
  <div class="altimeter__track"><div class="altimeter__fill" id="altFill"></div></div>
  <div class="altimeter__read altimeter__tag">experience altitude</div>
</aside>

<main>

<!-- ====== HERO ====== -->
<section class="hero">
  <div class="hero__media" id="heroMedia"><img src="/assets/hero.jpg" alt="Last light on Gasherbrum IV above the Baltoro Glacier" fetchpriority="high"></div>
  <div class="hero__scrim"></div>
  <div class="wrap hero__in">
    <div>
      <p class="eyebrow">Karakoram · Himalaya · Hindu Kush</p>
      <h1 class="d1">Explore<br>Beyond Limits</h1>
      <p class="hero__sub">Luxury trekking expeditions and unforgettable mountain experiences across Pakistan's most iconic landscapes.</p>
      <div class="hero__actions">
        <a href="#services" class="btn btn--pd">Explore experiences <span class="arw"></span></a>
        <a href="#contact" class="btn btn--sd">Plan your journey</a>
      </div>
    </div>

    <%- include("partials/enquiry-form", { p: "h" }) %>
  </div>
</section>

<!-- ====== THREE WAYS TO TRAVEL WITH US ====== -->
<section class="section" id="services">
  <div class="wrap">
    <div class="chead rv">
      <p class="eyebrow">What we do</p>
      <h2 class="d2">Three Ways to Travel With Us</h2>
      <p class="chead__sub chead__sub--wide">Every experience is privately run, fully supported and built around your group.</p>
    </div>
    <div class="cats">
<% [["trekking", "#expeditions", "Trekking Expeditions"], ["tours", "#tours", "Tours and Sightseeing"], ["spiritual", "#spiritual", "Spiritual Trips and Yoga Retreats"]].forEach(([key, anchor, label], i) => { const c = categories[key]; %>
      <div class="catcol rv">
        <a href="<%= anchor %>" class="cat">
          <img src="/assets/<%= c.image %>" alt="<%= c.imageAlt %>" loading="lazy" decoding="async">
          <div class="cat__c"><span class="cat__n">0<%= i + 1 %></span><h3 class="d3"><%= label %></h3>
            <p><%= c.blurb %></p></div>
        </a>
        <ul class="strips">
<% strips[key].forEach((t) => { %>          <li><a class="strip" href="<%= t.url %>"><span><%= t.title %></span><span class="arw"></span></a></li>
<% }) %><% if (key === "spiritual") { %>          <li><a class="strip" href="/corporate"><span>Corporate and Team Retreats</span><span class="arw"></span></a></li>
<% } %>        </ul>
      </div>
<% }) %>
    </div>
  </div>
</section>

<!-- ====== TREKKING EXPEDITIONS ====== -->
<section class="section" id="expeditions" style="background:var(--mist)">
  <div class="wrap">
    <div class="chead rv">
      <span class="chead__icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2 19h20L15 6l-4 7-2-3-7 9z"/><path d="M13.2 9.8l1.8-1.3 1.7 1.2"/></svg></span>
      <h2 class="d2">Trekking Expeditions</h2>
      <p class="chead__sub">Routes worth the year you'll spend thinking about them.</p>
    </div>

    <div class="grid-3">
<% featured.trekking.forEach((trip) => { %><%- include("partials/trip-card", { trip }) %><% }) %>
    </div>
    <div class="center-cta rv"><a href="#contact" class="tlink">Enquire about an expedition <span class="arw"></span></a></div>
  </div>
</section>

<!-- ====== TOURS AND SIGHTSEEING ====== -->
<section class="section" id="tours">
  <div class="wrap">
    <div class="chead rv">
      <span class="chead__icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 15h18v-3l-2-4H8l-3 4H3z"/><circle cx="7.5" cy="17" r="2"/><circle cx="16.5" cy="17" r="2"/><path d="M12 8v4"/></svg></span>
      <h2 class="d2">Tours and Sightseeing</h2>
      <p class="chead__sub">The north in five days, or the country in two weeks.</p>
    </div>

    <div class="dests">
<% featured.tours.forEach((trip) => { %><%- include("partials/trip-card", { trip }) %><% }) %>
    </div>
    <div class="center-cta rv"><a href="#contact" class="tlink">Enquire about a tour <span class="arw"></span></a></div>
  </div>
</section>

<!-- ====== RELIGIOUS AND SPIRITUAL JOURNEYS ====== -->
<section class="section" id="spiritual" style="background:var(--mist)">
  <div class="wrap">
    <div class="chead rv">
      <span class="chead__icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20V11a8 8 0 0 1 16 0v9"/><path d="M2 20h20"/><path d="M9 20v-4a3 3 0 0 1 6 0v4"/></svg></span>
      <h2 class="d2">Religious and Spiritual Journeys</h2>
      <p class="chead__sub">Routes that were walked long before they were itineraries.</p>
    </div>

    <div class="grid-3">
<% featured.spiritual.forEach((trip) => { %><%- include("partials/trip-card", { trip }) %><% }) %>
    </div>
    <div class="center-cta rv"><a href="#contact" class="tlink">Enquire about a journey <span class="arw"></span></a></div>
  </div>
</section>

<!-- ====== SIGNATURE DESTINATIONS ====== -->
<section class="section" id="destinations">
  <div class="wrap">
    <div class="chead chead--tight rv">
      <p class="eyebrow">Signature Destinations</p>
      <h2 class="d2">Five places we return to, and never the same way twice.</h2>
    </div>
    <div class="index rv">
<% destinations.forEach((d) => { %>      <a href="<%= d.link %>" class="irow"><div class="irow__l"><h3 class="d3"><%= d.name %></h3><span class="data"><%= d.region %></span></div><div class="irow__r"><span class="data"><%= d.altitude %></span><span class="data"><%= d.season %></span></div></a>
<% }) %>    </div>
  </div>
</section>

<%- include("partials/promise") %>

<!-- ====== CORPORATE RETREATS ====== -->
<section class="section on-dark" id="corporate">
  <div class="wrap corp">
    <div class="corp__media rv"><img src="/assets/camp.jpg" alt="Expedition camp under the stars at Goro II, Masherbrum behind" loading="lazy" decoding="async"></div>
    <div class="rv">
      <p class="eyebrow">Corporate retreats</p>
      <h2 class="d2">Take the leadership team above three thousand metres.</h2>
      <ul class="corp__list">
<% featured.corporate.forEach((t) => { %>        <li><span class="data"><%= t.duration %></span> <a href="<%= t.url %>"><%= t.shortDescription %></a></li>
<% }) %>      </ul>
      <a href="/corporate" class="btn btn--sd">Request a proposal <span class="arw"></span></a>
    </div>
  </div>
</section>

<!-- ====== PAST EXPEDITIONS AND MEMORIES ====== -->
<section class="section" id="memories">
  <div class="wrap">
    <div class="chead chead--tight rv" style="max-width:820px">
      <h2 class="d2">Our Past Expeditions and Unforgettable Memories</h2>
    </div>
    <div class="mem rv">
<% posts.forEach((post) => { %>      <a href="<%= post.published ? post.url : "/blog" %>">
        <div class="mem__m"><% if (post.coverImage) { %><img src="<%= post.coverImage %>" alt="<%= post.coverAlt || post.title %>" loading="lazy" decoding="async"><% } %></div>
        <h3><%= post.title %></h3>
        <p><%= post.excerpt %></p>
      </a>
<% }) %>    </div>
    <div class="center-cta rv"><a href="/blog" class="tlink">Read the journal <span class="arw"></span></a></div>
  </div>
</section>

<!-- ====== TESTIMONIALS ====== -->
<% if (testimonials.length) { %>
<section class="section" id="testimonials" style="background:var(--mist)">
  <div class="wrap">
    <div class="quotes rv" id="quotes">
<% testimonials.forEach((t, i) => { %>      <div class="quote<%= i === 0 ? " is-live" : "" %>">
        <div class="avatar"><% if (t.image) { %><img src="<%= t.image %>" alt="<%= t.name %>" loading="lazy"><% } else { %><svg viewBox="0 0 76 76" aria-hidden="true"><rect width="76" height="76" fill="#E4E4E4"/><circle cx="38" cy="30" r="13" fill="#B9B9B9"/><path d="M12 76c0-14.4 11.6-24 26-24s26 9.6 26 24z" fill="#B9B9B9"/></svg><% } %></div>
        <blockquote><%= t.quote %></blockquote>
        <cite><b><%= t.name %></b><%= t.cite %></cite>
      </div>
<% }) %>    </div>
    <div class="qnav" id="qnav">
<% testimonials.forEach((t, i) => { %>      <button class="qdot<%= i === 0 ? " is-live" : "" %>" aria-label="Testimonial <%= i + 1 %>"></button>
<% }) %>    </div>
    <div class="center-cta rv"><a href="/testimonials" class="tlink">All client testimonials <span class="arw"></span></a></div>
  </div>
</section>
<% } %>

<!-- ====== FOLLOW THE EXPEDITION ====== -->
<section class="section">
  <div class="wrap">
    <div class="chead chead--tight rv">
      <p class="eyebrow">@xpitude</p>
      <h2 class="d3">Follow the expedition.</h2>
    </div>
    <div class="gram rv">
<% [["ig1", "On the snow below Nanga Parbat"], ["ig2", "Our guide with children on the walk in"], ["ig3", "Alpenglow on the Gasherbrum group"], ["ig4", "Above the Hunza valley"], ["ig5", "Camp lights at Goro II"], ["ig6", "Fairy Meadows at night"]].forEach(([file, alt]) => { %><% if (site.social.instagram) { %>      <a href="<%= site.social.instagram %>" rel="noopener" target="_blank"><img src="/assets/<%= file %>.jpg" alt="<%= alt %>" loading="lazy" decoding="async"></a>
<% } else { %>      <div class="gram__i"><img src="/assets/<%= file %>.jpg" alt="<%= alt %>" loading="lazy" decoding="async"></div>
<% } %><% }) %>    </div>
  </div>
</section>

<!-- ====== FINAL CONTACT FORM ====== -->
<section class="section on-dark" id="contact">
  <div class="wrap contact">
    <div class="rv">
      <p class="eyebrow">Start planning</p>
      <h2 class="d2">Tell us the month. We'll tell you what's possible.</h2>
      <p class="lede" style="margin-top:16px">Send a rough idea and a rough date. A planner comes back within one working day with two or three routes that fit your group, and an honest word about the one that does not.</p>
<%- include("partials/contact-details") %>
    </div>

    <%- include("partials/enquiry-form", { p: "c", dark: true, reveal: true }) %>
  </div>
</section>
</main>

<%- include("partials/footer") %>
