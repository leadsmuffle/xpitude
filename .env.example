# Copy this file to .env and fill it in. Never commit .env.

# --- Server ---
PORT=3000
NODE_ENV=development
# The public address of the site, no trailing slash. Used for canonical URLs, the sitemap and email links.
SITE_URL=http://localhost:3000

# --- Database ---
# Local MongoDB:
MONGO_URI=mongodb://127.0.0.1:27017/xpitude
# MongoDB Atlas (replace user, password and cluster):
# MONGO_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/xpitude?retryWrites=true&w=majority

# --- Admin ---
# A long random string, 32 characters or more. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# The admin user is created (or its password updated) each time you run: npm run seed
ADMIN_EMAIL=
# 10 characters or more
ADMIN_PASSWORD=

# --- Email (enquiry notifications and the customer auto-reply) ---
# Leave SMTP_HOST empty to switch email off; enquiries are still saved.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Optional. The address emails are sent from. Defaults to SMTP_USER.
SMTP_FROM=
# Where new enquiry notifications are sent. Defaults to CONTACT_EMAIL.
NOTIFY_EMAIL=

# --- Contact details shown on every page ---
# These are placeholders. Replace them with the real XPITUDE details.
PHONE=+92 000 000 0000
# A number (digits with country code) or a full https://wa.me/... link
WHATSAPP=+92 000 000 0000
CONTACT_EMAIL=hello@expedute.com

# --- Social links (optional). An icon only appears when its link is set. ---
INSTAGRAM_URL=
TIKTOK_URL=
YOUTUBE_URL=
FACEBOOK_URL=

# --- Social icons in the header and footer. An icon is hidden when its link is empty. ---
SOCIAL_LINKEDIN=https://www.linkedin.com/company/xpitude
SOCIAL_FACEBOOK=https://www.facebook.com/xpitude
SOCIAL_INSTAGRAM=https://www.instagram.com/xpitude
SOCIAL_X=https://x.com/xpitude
